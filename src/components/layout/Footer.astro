---
import type { Locale } from '@/lib/i18n/config';
import type { SiteSettings } from '@/lib/content';
import { navItems } from '@/lib/i18n/config';
import { getPagePath } from '@/lib/i18n/utils';
import { t } from '@/lib/i18n/labels';
import Button from '@/components/ui/Button.astro';

interface Props {
  locale: Locale;
  settings: SiteSettings;
}

const { locale, settings } = Astro.props;
const whatsappUrl = `https://wa.me/${settings.contact.whatsapp}`;
const year = new Date().getFullYear();
const footerNav = navItems.filter((item) => item.key !== 'home');
---

<footer class="mt-auto border-t border-bark-slate/20 bg-primary text-sand-surface">
  <div
    class="mx-auto flex max-w-[var(--container-max)] flex-col gap-[var(--spacing-stack-lg)] px-[var(--spacing-margin-mobile)] py-[var(--spacing-section)] md:flex-row md:items-start md:justify-between md:px-[var(--spacing-gutter)]"
  >
    <div class="max-w-md">
      <p class="font-display text-headline-md uppercase tracking-widest text-white">
        {settings.siteName}
      </p>
      <p class="mt-4 text-sm text-white/60">{settings.tagline}</p>
      <div class="mt-6">
        <Button href={whatsappUrl} variant="gold" size="sm" external>
          {t('whatsapp', locale)}
        </Button>
      </div>
    </div>

    <nav class="flex flex-col gap-4 md:items-end">
      {
        footerNav.map((item) => (
          <a
            href={getPagePath(item.key, locale)}
            class="font-label-caps text-white/60 underline-offset-4 transition-colors hover:text-earth-gold hover:underline"
          >
            {item.label[locale]}
          </a>
        ))
      }
      <a
        href={getPagePath('privacy', locale)}
        class="font-label-caps text-white/60 underline-offset-4 transition-colors hover:text-earth-gold hover:underline"
      >
        {locale === 'es' ? 'Privacidad' : 'Privacy'}
      </a>
    </nav>
  </div>
  <div class="border-t border-white/10 px-[var(--spacing-gutter)] py-5 text-center font-label-caps text-white/40">
    © {year} {settings.siteName}. {locale === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}
  </div>
</footer>
