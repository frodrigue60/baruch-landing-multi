---
import type { Locale } from '@/lib/i18n/config';
import type { SiteSettings } from '@/lib/content';
import { getPagePath } from '@/lib/i18n/utils';

interface Props {
  locale: Locale;
  settings: SiteSettings;
}

const { locale, settings } = Astro.props;
const whatsappUrl = `https://wa.me/${settings.contact.whatsapp}`;
const labels = {
  contact: locale === 'es' ? 'Contacto' : 'Contact',
  privacy: locale === 'es' ? 'Privacidad' : 'Privacy',
  rights: locale === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.',
};
---

<footer class="border-t border-primary/10 bg-primary-dark text-white">
  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 md:grid-cols-3">
    <div>
      <p class="text-lg font-semibold">{settings.siteName}</p>
      <p class="mt-2 text-sm text-white/80">{settings.tagline}</p>
    </div>
    <div>
      <p class="font-medium">{labels.contact}</p>
      <ul class="mt-2 space-y-1 text-sm text-white/80">
        <li><a href={`tel:${settings.contact.phone}`} class="hover:text-white">{settings.contact.phone}</a></li>
        <li><a href={`mailto:${settings.contact.email}`} class="hover:text-white">{settings.contact.email}</a></li>
        <li><a href={whatsappUrl} class="hover:text-white" target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
      </ul>
    </div>
    <div>
      <ul class="space-y-2 text-sm">
        <li>
          <a href={getPagePath('contact', locale)} class="hover:text-accent">{labels.contact}</a>
        </li>
        <li>
          <a href={getPagePath('privacy', locale)} class="hover:text-accent">{labels.privacy}</a>
        </li>
        {
          settings.social.map((link) => (
            <li>
              <a href={link.url} class="hover:text-accent" target="_blank" rel="noopener noreferrer">
                {link.label ?? link.platform}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-white/60">
    © {new Date().getFullYear()} {settings.siteName}. {labels.rights}
  </div>
</footer>
