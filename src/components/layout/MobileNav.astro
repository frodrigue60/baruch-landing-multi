---
import type { Locale } from '@/lib/i18n/config';
import { t } from '@/lib/i18n/labels';
import NavLinks from '@/components/layout/NavLinks.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const menuLabel = locale === 'es' ? 'Menú principal' : 'Main menu';
---

<details class="mobile-nav relative lg:hidden">
  <summary
    class="flex h-10 w-10 cursor-pointer items-center justify-center border border-bark-slate/20 bg-surface text-primary"
    aria-label={t('menuOpen', locale)}
  >
    <svg class="mobile-nav-icon-open h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="square" />
    </svg>
    <svg class="mobile-nav-icon-close h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="square" />
    </svg>
  </summary>
  <nav
    class="absolute left-0 top-full z-50 mt-2 min-w-[16rem] border border-bark-slate/10 bg-sand-surface p-4"
    aria-label={menuLabel}
  >
    <NavLinks locale={locale} currentPath={currentPath} />
  </nav>
</details>
