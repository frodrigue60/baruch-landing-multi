---
import type { Locale } from '@/lib/i18n/config';
import { locales } from '@/lib/i18n/config';
import { switchLocalePath } from '@/lib/i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
---

<div class="font-label-caps text-primary">
  {
    locales.map((item, index) => (
      <>
        {index > 0 && <span class="text-bark-slate/40"> | </span>}
        <a
          href={switchLocalePath(currentPath, item)}
          class:list={[
            'uppercase tracking-widest transition-colors hover:text-earth-gold',
            item === locale ? 'text-primary' : 'text-on-surface-variant',
          ]}
          aria-current={item === locale ? 'page' : undefined}
        >
          {item.toUpperCase()}
        </a>
      </>
    ))
  }
</div>
