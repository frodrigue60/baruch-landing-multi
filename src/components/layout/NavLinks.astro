---
import type { Locale } from '@/lib/i18n/config';
import { navItems } from '@/lib/i18n/config';
import { getPagePath } from '@/lib/i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
  class?: string;
}

const { locale, currentPath, class: className = '' } = Astro.props;

function isActive(href: string): boolean {
  if (href === getPagePath('home', locale)) {
    return currentPath === href || currentPath === `${href}/`;
  }
  return currentPath.startsWith(href);
}
---

<ul class:list={['flex flex-col gap-1 md:flex-row md:items-center md:gap-1', className]}>
  {
    navItems.map((item) => {
      const href = getPagePath(item.key, locale);
      const active = isActive(href);
      return (
        <li>
          <a
            href={href}
            class:list={[
              'block rounded-lg px-3 py-2 text-sm font-medium transition-colors md:py-1.5',
              active
                ? 'bg-primary/10 text-primary'
                : 'text-gray-700 hover:bg-primary/5 hover:text-primary',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label[locale]}
          </a>
        </li>
      );
    })
  }
</ul>
