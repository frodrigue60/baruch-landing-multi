---
import type { Locale } from '@/lib/i18n/config';
import { navItems } from '@/lib/i18n/config';
import { getPagePath } from '@/lib/i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
  class?: string;
  /** Hide home link when the brand wordmark already links home (desktop header). */
  excludeHome?: boolean;
}

const { locale, currentPath, class: className = '', excludeHome = false } = Astro.props;

const items = excludeHome ? navItems.filter((item) => item.key !== 'home') : navItems;

function isActive(href: string): boolean {
  const normalized = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
  const homeHref = getPagePath('home', locale);
  if (href === homeHref) {
    return normalized === '/' || normalized === homeHref;
  }
  return normalized === href || normalized.startsWith(href);
}
---

<ul class:list={['flex flex-col gap-1 lg:flex-row lg:items-center', className]}>
  {
    items.map((item) => {
      const href = getPagePath(item.key, locale);
      const active = isActive(href);
      return (
        <li>
          <a
            href={href}
            class:list={[
              'font-label-caps block py-2 transition-colors duration-300 lg:py-0',
              active ? 'text-primary' : 'text-on-surface-variant hover:text-earth-gold',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label[locale]}
          </a>
        </li>
      );
    })
  }
</ul>
