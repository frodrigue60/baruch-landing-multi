---
import type { Locale } from '@/lib/i18n/config';
import { getPagePath } from '@/lib/i18n/utils';
import { t } from '@/lib/i18n/labels';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import NavLinks from '@/components/layout/NavLinks.astro';
import MobileNav from '@/components/layout/MobileNav.astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  locale: Locale;
  siteName: string;
  whatsapp: string;
}

const { locale, siteName, whatsapp } = Astro.props;
const currentPath = Astro.url.pathname;
const whatsappUrl = `https://wa.me/${whatsapp}`;
---

<header class="sticky top-0 z-50 border-b border-border bg-surface-elevated/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 md:py-4">
    <a
      href={getPagePath('home', locale)}
      class="flex shrink-0 items-center gap-2 text-primary"
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary text-sm font-bold text-white"
        aria-hidden="true"
      >
        B
      </span>
      <span class="font-display text-xl font-bold tracking-tight">{siteName}</span>
    </a>

    <nav
      class="hidden flex-1 justify-center md:flex"
      aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}
    >
      <NavLinks locale={locale} currentPath={currentPath} class="md:gap-0.5" />
    </nav>

    <div class="ml-auto flex items-center gap-2 md:gap-3">
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
      <Button
        href={whatsappUrl}
        variant="secondary"
        size="sm"
        external
        class="hidden sm:inline-flex"
      >
        {t('whatsappShort', locale)}
      </Button>
      <MobileNav locale={locale} currentPath={currentPath} />
    </div>
  </div>
</header>
