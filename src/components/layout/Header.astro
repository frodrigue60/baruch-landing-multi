---
import type { Locale } from '@/lib/i18n/config';
import { getPagePath } from '@/lib/i18n/utils';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import NavLinks from '@/components/layout/NavLinks.astro';
import MobileNav from '@/components/layout/MobileNav.astro';

interface Props {
  locale: Locale;
  siteName: string;
  whatsapp: string;
}

const { locale, siteName } = Astro.props;
const currentPath = Astro.url.pathname;
const navLabel = locale === 'es' ? 'Navegación principal' : 'Main navigation';
const brandClass =
  'font-display shrink-0 text-headline-md uppercase tracking-widest text-primary transition-opacity hover:opacity-80';
---

<header class="sticky top-0 z-50 w-full border-b border-bark-slate/10 bg-surface">
  <!-- Mobile / tablet: menu | brand | language -->
  <div
    class="mx-auto grid max-w-[var(--container-max)] grid-cols-[1fr_auto_1fr] items-center px-[var(--spacing-margin-mobile)] py-4 lg:hidden"
  >
    <div class="flex justify-start">
      <MobileNav locale={locale} currentPath={currentPath} />
    </div>
    <a href={getPagePath('home', locale)} class={brandClass}>
      {siteName}
    </a>
    <div class="flex justify-end">
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
    </div>
  </div>

  <!-- Desktop: brand left | nav + language right -->
  <div
    class="mx-auto hidden max-w-[var(--container-max)] items-center justify-between gap-8 px-[var(--spacing-gutter)] py-4 lg:flex"
  >
    <a href={getPagePath('home', locale)} class={brandClass}>
      {siteName}
    </a>
    <div class="flex items-center gap-8">
      <nav aria-label={navLabel}>
        <NavLinks locale={locale} currentPath={currentPath} excludeHome class="gap-6" />
      </nav>
      <LanguageSwitcher locale={locale} currentPath={currentPath} />
    </div>
  </div>
</header>
