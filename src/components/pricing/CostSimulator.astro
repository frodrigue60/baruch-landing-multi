---
import type { Locale } from '@/lib/i18n/config';
import type { PricingConfig } from '@/lib/content/types';
import { getPagePath } from '@/lib/i18n/utils';

interface Props {
  config: PricingConfig;
  locale: Locale;
  whatsapp: string;
  contactPath?: string;
}

const { config, locale, whatsapp } = Astro.props;
const contactPath = Astro.props.contactPath ?? getPagePath('contact', locale);
const labels = {
  step1: locale === 'es' ? '1. Selecciona tu retiro' : '1. Select your retreat',
  step2: locale === 'es' ? '2. Define tu estancia' : '2. Define your stay',
  package: locale === 'es' ? 'Paquete / plan' : 'Package / plan',
  personType: locale === 'es' ? 'Tipo de persona' : 'Person type',
  reservation: locale === 'es' ? 'Tipo de reservación' : 'Reservation type',
  location: locale === 'es' ? 'Ubicación' : 'Location',
  days: locale === 'es' ? 'Días' : 'Days',
  guests: locale === 'es' ? 'Personas' : 'Guests',
  estimate: locale === 'es' ? 'Resumen de cotización' : 'Quote summary',
  total: locale === 'es' ? 'Estimación total' : 'Total estimate',
  perDay: locale === 'es' ? 'Por día (grupo)' : 'Per day (group)',
  perPersonDay: locale === 'es' ? 'Por persona / día' : 'Per person / day',
  breakdown: locale === 'es' ? 'Desglose' : 'Breakdown',
  contact: locale === 'es' ? 'Continuar en contacto' : 'Continue on contact',
  whatsapp: locale === 'es' ? 'Enviar por WhatsApp' : 'Send via WhatsApp',
  from: locale === 'es' ? 'Desde' : 'From',
};

const configJson = JSON.stringify(config);
const fieldClass =
  'mt-2 w-full border border-bark-slate/20 bg-surface px-4 py-3 text-deep-forest transition-colors focus:border-earth-gold focus:outline-none';
const labelClass = 'font-label-caps text-on-surface-variant';
---

<div
  id="cost-simulator"
  class="grid items-start gap-[var(--spacing-gutter)] lg:grid-cols-12"
  data-locale={locale}
  data-whatsapp={whatsapp}
  data-contact={contactPath}
>
  <script type="application/json" id="pricing-config" set:html={configJson} />

  <form id="cost-simulator-form" class="contents">
    <div class="space-y-[var(--spacing-stack-lg)] lg:col-span-8">
      <div>
        <div class="mb-6 flex items-center gap-4 border-b border-bark-slate/10 pb-4">
          <h2 class="font-display text-headline-md text-deep-forest">{labels.step1}</h2>
        </div>

        <fieldset>
          <legend class="sr-only">{labels.package}</legend>
          <div class="grid gap-4 md:grid-cols-2">
            {
              config.packages.map((pkg, index) => (
                <label class="package-option group relative cursor-pointer border border-bark-slate/20 bg-surface p-6 transition-colors duration-300 hover:bg-sand-surface has-[:checked]:border-earth-gold has-[:checked]:bg-sand-surface">
                  <input
                    type="radio"
                    name="package-visual"
                    value={pkg.id}
                    class="peer sr-only"
                    checked={index === 0}
                    data-sim-package
                  />
                  <span
                    class="absolute top-6 right-6 z-10 font-label-caps text-earth-gold opacity-0 peer-checked:opacity-100"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  {
                    pkg.image && (
                      <div class="relative mb-4 h-32 overflow-hidden bg-bark-slate/5">
                        <img
                          src={pkg.image}
                          alt=""
                          class="h-full w-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 peer-checked:grayscale-0"
                          loading="lazy"
                        />
                      </div>
                    )
                  }
                  <h3 class="font-display text-headline-md text-deep-forest">{pkg.name}</h3>
                  <p class="mt-2 text-sm text-on-surface-variant">{pkg.summary}</p>
                  <p class="font-label-caps mt-4 text-earth-gold">
                    {labels.from} {config.currencySymbol}
                    {pkg.basePricePerDay.toLocaleString(locale === 'en' ? 'en-US' : 'es-MX')}
                  </p>
                </label>
              ))
            }
          </div>
        </fieldset>
        <select id="sim-package" name="package" class="sr-only" tabindex="-1" aria-hidden="true">
          {
            config.packages.map((pkg) => (
              <option value={pkg.id}>{pkg.name}</option>
            ))
          }
        </select>
      </div>

      <div>
        <div class="mb-6 flex items-center gap-4 border-b border-bark-slate/10 pb-4">
          <h2 class="font-display text-headline-md text-deep-forest">{labels.step2}</h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <label for="sim-person" class={labelClass}>{labels.personType}</label>
            <select id="sim-person" name="person" class={fieldClass}>
              {
                config.personTypes.map((option) => (
                  <option value={option.id}>
                    {option.label} ({Math.round(option.multiplier * 100)}%)
                  </option>
                ))
              }
            </select>
            <p id="sim-person-desc" class="mt-1 text-xs text-on-surface-variant"></p>
          </div>

          <div>
            <label for="sim-reservation" class={labelClass}>{labels.reservation}</label>
            <select id="sim-reservation" name="reservation" class={fieldClass}>
              {
                config.reservationTypes.map((option) => (
                  <option value={option.id}>
                    {option.label} ({Math.round(option.multiplier * 100)}%)
                  </option>
                ))
              }
            </select>
            <p id="sim-reservation-desc" class="mt-1 text-xs text-on-surface-variant"></p>
          </div>

          <div>
            <label for="sim-location" class={labelClass}>{labels.location}</label>
            <select id="sim-location" name="location" class={fieldClass}>
              {
                config.locations.map((option) => (
                  <option value={option.id}>
                    {option.label} ({Math.round(option.multiplier * 100)}%)
                  </option>
                ))
              }
            </select>
            <p id="sim-location-desc" class="mt-1 text-xs text-on-surface-variant"></p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="sim-days" class={labelClass}>{labels.days}</label>
              <input
                id="sim-days"
                name="days"
                type="number"
                min={config.minDays}
                max={config.maxDays}
                value="2"
                class={fieldClass}
              />
            </div>
            <div>
              <label for="sim-guests" class={labelClass}>{labels.guests}</label>
              <input
                id="sim-guests"
                name="guests"
                type="number"
                min={config.minGuests}
                max={config.maxGuests}
                value="2"
                class={fieldClass}
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="lg:col-span-4">
      <div class="sticky top-24 border border-bark-slate/10 bg-sand-surface p-8">
        <h3 class="font-display mb-6 border-b border-bark-slate/10 pb-4 text-headline-md text-deep-forest">
          {labels.estimate}
        </h3>

        <p class="font-label-caps text-on-surface-variant">{labels.total}</p>
        <p id="sim-total" class="font-display mt-2 text-4xl text-deep-forest" aria-live="polite">—</p>

        <dl class="mt-6 space-y-4 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="font-label-caps text-on-surface-variant">{labels.perPersonDay}</dt>
            <dd id="sim-per-person-day" class="text-deep-forest">—</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="font-label-caps text-on-surface-variant">{labels.perDay}</dt>
            <dd id="sim-per-day" class="text-deep-forest">—</dd>
          </div>
        </dl>

        <div class="mt-6 border-t border-bark-slate/10 pt-4">
          <p class="font-label-caps text-deep-forest">{labels.breakdown}</p>
          <ul id="sim-breakdown" class="mt-2 space-y-1 text-xs text-on-surface-variant"></ul>
        </div>

        <p class="mt-6 text-xs leading-relaxed text-on-surface-variant">{config.disclaimer}</p>

        <div class="mt-8 flex flex-col gap-3">
          <a
            id="sim-whatsapp"
            href={`https://wa.me/${whatsapp}`}
            class="inline-flex items-center justify-center bg-earth-gold px-8 py-4 font-label-caps text-deep-forest transition-colors hover:bg-secondary-fixed-dim"
            target="_blank"
            rel="noopener noreferrer"
          >
            {labels.whatsapp}
          </a>
          <a
            href={contactPath}
            class="inline-flex items-center justify-center border border-deep-forest px-8 py-4 font-label-caps text-deep-forest transition-colors hover:bg-deep-forest hover:text-sand-surface"
          >
            {labels.contact}
          </a>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  type PricingOption = { id: string; label: string; description: string; multiplier: number };
  type PricingPackage = {
    id: string;
    name: string;
    basePricePerDay: number;
  };
  type PricingConfig = {
    currencySymbol: string;
    minDays: number;
    maxDays: number;
    minGuests: number;
    maxGuests: number;
    packages: PricingPackage[];
    personTypes: PricingOption[];
    reservationTypes: PricingOption[];
    locations: PricingOption[];
  };

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  function formatMoney(amount: number, symbol: string, locale: string) {
    const formatted = new Intl.NumberFormat(locale === 'en' ? 'en-US' : 'es-MX', {
      maximumFractionDigits: 0,
    }).format(Math.round(amount));
    return `${symbol}${formatted}`;
  }

  function findById<T extends { id: string }>(items: T[], id: string) {
    return items.find((item) => item.id === id);
  }

  function initSimulator() {
    const root = document.getElementById('cost-simulator');
    const configEl = document.getElementById('pricing-config');
    if (!root || !configEl?.textContent) return;

    const config = JSON.parse(configEl.textContent) as PricingConfig;
    const locale = root.dataset.locale ?? 'es';
    const whatsapp = root.dataset.whatsapp ?? '';

    const packageSelect = document.getElementById('sim-package') as HTMLSelectElement | null;
    const personSelect = document.getElementById('sim-person') as HTMLSelectElement | null;
    const reservationSelect = document.getElementById('sim-reservation') as HTMLSelectElement | null;
    const locationSelect = document.getElementById('sim-location') as HTMLSelectElement | null;
    const daysInput = document.getElementById('sim-days') as HTMLInputElement | null;
    const guestsInput = document.getElementById('sim-guests') as HTMLInputElement | null;

    const totalEl = document.getElementById('sim-total');
    const perPersonEl = document.getElementById('sim-per-person-day');
    const perDayEl = document.getElementById('sim-per-day');
    const breakdownEl = document.getElementById('sim-breakdown');
    const whatsappLink = document.getElementById('sim-whatsapp') as HTMLAnchorElement | null;

    const personDesc = document.getElementById('sim-person-desc');
    const reservationDesc = document.getElementById('sim-reservation-desc');
    const locationDesc = document.getElementById('sim-location-desc');

    function updateDescriptions() {
      const person = findById(config.personTypes, personSelect?.value ?? '');
      const reservation = findById(config.reservationTypes, reservationSelect?.value ?? '');
      const location = findById(config.locations, locationSelect?.value ?? '');
      if (personDesc) personDesc.textContent = person?.description ?? '';
      if (reservationDesc) reservationDesc.textContent = reservation?.description ?? '';
      if (locationDesc) locationDesc.textContent = location?.description ?? '';
    }

    function recalculate() {
      const checked = document.querySelector<HTMLInputElement>('input[data-sim-package]:checked');
      if (checked && packageSelect) packageSelect.value = checked.value;

      const selectedPackage = findById(config.packages, packageSelect?.value ?? '');
      const person = findById(config.personTypes, personSelect?.value ?? '');
      const reservation = findById(config.reservationTypes, reservationSelect?.value ?? '');
      const location = findById(config.locations, locationSelect?.value ?? '');

      if (!selectedPackage || !person || !reservation || !location) return;

      const days = clamp(Number(daysInput?.value || 1), config.minDays, config.maxDays);
      const guests = clamp(Number(guestsInput?.value || 1), config.minGuests, config.maxGuests);

      if (daysInput) daysInput.value = String(days);
      if (guestsInput) guestsInput.value = String(guests);

      const pricePerPersonPerDay =
        selectedPackage.basePricePerDay *
        person.multiplier *
        reservation.multiplier *
        location.multiplier;
      const subtotalPerDay = pricePerPersonPerDay * guests;
      const total = subtotalPerDay * days;

      if (totalEl) totalEl.textContent = formatMoney(total, config.currencySymbol, locale);
      if (perPersonEl) {
        perPersonEl.textContent = formatMoney(pricePerPersonPerDay, config.currencySymbol, locale);
      }
      if (perDayEl) {
        perDayEl.textContent = formatMoney(subtotalPerDay, config.currencySymbol, locale);
      }

      if (breakdownEl) {
        const lines =
          locale === 'es'
            ? [
                `Tarifa base: ${formatMoney(selectedPackage.basePricePerDay, config.currencySymbol, locale)} / persona / día`,
                `Tipo de persona (${person.label}): ×${person.multiplier}`,
                `Reservación (${reservation.label}): ×${reservation.multiplier}`,
                `Ubicación (${location.label}): ×${location.multiplier}`,
                `${days} día(s) × ${guests} persona(s)`,
              ]
            : [
                `Base rate: ${formatMoney(selectedPackage.basePricePerDay, config.currencySymbol, locale)} / person / day`,
                `Person type (${person.label}): ×${person.multiplier}`,
                `Reservation (${reservation.label}): ×${reservation.multiplier}`,
                `Location (${location.label}): ×${location.multiplier}`,
                `${days} day(s) × ${guests} guest(s)`,
              ];
        breakdownEl.innerHTML = lines.map((line) => `<li>${line}</li>`).join('');
      }

      if (whatsappLink) {
        const message =
          locale === 'es'
            ? `Hola Baruch, me interesa una estimación:\n• Paquete: ${selectedPackage.name}\n• Persona: ${person.label}\n• Reservación: ${reservation.label}\n• Ubicación: ${location.label}\n• Días: ${days}\n• Personas: ${guests}\n• Estimación: ${formatMoney(total, config.currencySymbol, locale)} MXN\n(Estimación orientativa del sitio)`
            : `Hi Baruch, I'm interested in an estimate:\n• Package: ${selectedPackage.name}\n• Person: ${person.label}\n• Reservation: ${reservation.label}\n• Location: ${location.label}\n• Days: ${days}\n• Guests: ${guests}\n• Estimate: ${formatMoney(total, config.currencySymbol, locale)} MXN\n(Indicative site estimate)`;
        whatsappLink.href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`;
      }

      updateDescriptions();
    }

    const radios = document.querySelectorAll<HTMLInputElement>('input[data-sim-package]');
    for (const radio of radios) {
      radio.addEventListener('change', recalculate);
    }

    const controls = [personSelect, reservationSelect, locationSelect, daysInput, guestsInput];
    for (const control of controls) {
      control?.addEventListener('change', recalculate);
      control?.addEventListener('input', recalculate);
    }

    recalculate();
  }

  initSimulator();
  document.addEventListener('astro:page-load', initSimulator);
</script>
