---
import type { Locale } from '@/lib/i18n/config';
import type { SiteSettings } from '@/lib/content';

interface Props {
  locale: Locale;
  settings: SiteSettings;
}

const { locale, settings } = Astro.props;
const whatsappUrl = `https://wa.me/${settings.contact.whatsapp}`;
---

<section class="mx-auto max-w-2xl px-4 py-12">
  <h1 class="text-3xl font-bold text-primary">
    {locale === 'es' ? 'Solicitar cotización' : 'Request a quote'}
  </h1>
  <p class="mt-2 text-gray-600">
    {
      locale === 'es'
        ? 'El envío en línea estará disponible próximamente. Mientras tanto, contáctanos directamente.'
        : 'Online submission will be available soon. In the meantime, contact us directly.'
    }
  </p>

  <form class="mt-8 space-y-4" aria-disabled="true" novalidate>
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700">
        {locale === 'es' ? 'Nombre' : 'Name'}
      </label>
      <input
        id="name"
        name="name"
        type="text"
        disabled
        class="mt-1 w-full rounded border border-gray-300 bg-gray-50 px-3 py-2 text-gray-500"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        disabled
        class="mt-1 w-full rounded border border-gray-300 bg-gray-50 px-3 py-2 text-gray-500"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700">
        {locale === 'es' ? 'Teléfono' : 'Phone'}
      </label>
      <input
        id="phone"
        name="phone"
        type="tel"
        disabled
        class="mt-1 w-full rounded border border-gray-300 bg-gray-50 px-3 py-2 text-gray-500"
      />
    </div>
    <div>
      <label for="message" class="block text-sm font-medium text-gray-700">
        {locale === 'es' ? 'Mensaje' : 'Message'}
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        disabled
        class="mt-1 w-full rounded border border-gray-300 bg-gray-50 px-3 py-2 text-gray-500"
      ></textarea>
    </div>
    <button
      type="button"
      disabled
      aria-disabled="true"
      class="cursor-not-allowed rounded bg-gray-400 px-6 py-2 font-semibold text-white"
    >
      {locale === 'es' ? 'Envío no disponible' : 'Submission unavailable'}
    </button>
  </form>

  <div class="mt-8 rounded-lg border border-accent/30 bg-white p-4">
    <p class="font-medium text-primary">
      {locale === 'es' ? 'Contacto directo' : 'Direct contact'}
    </p>
    <ul class="mt-2 space-y-1 text-sm text-gray-700">
      <li>
        <a href={whatsappUrl} class="text-primary underline" target="_blank" rel="noopener noreferrer">
          WhatsApp
        </a>
      </li>
      <li>
        <a href={`mailto:${settings.contact.email}`} class="text-primary underline">
          {settings.contact.email}
        </a>
      </li>
      <li>
        <a href={`tel:${settings.contact.phone}`} class="text-primary underline">
          {settings.contact.phone}
        </a>
      </li>
    </ul>
  </div>
</section>
