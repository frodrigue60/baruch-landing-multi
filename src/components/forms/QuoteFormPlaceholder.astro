---
import type { Locale } from '@/lib/i18n/config';
import type { PageContent, SiteSettings } from '@/lib/content';
import Button from '@/components/ui/Button.astro';

interface Props {
  locale: Locale;
  settings: SiteSettings;
  page: PageContent;
}

const { locale, settings, page } = Astro.props;
const whatsappUrl = `https://wa.me/${settings.contact.whatsapp}`;
const requestSection = page.sections?.find((s) => s.id === 'request') ?? page.sections?.[0];
---

<section id="solicitud" class="scroll-mt-24">
  <h2 class="text-2xl font-bold text-primary">
    {requestSection?.heading ?? (locale === 'es' ? 'Solicitar información' : 'Request information')}
  </h2>
  {
    requestSection?.body && (
      <p class="mt-2 text-muted">{requestSection.body}</p>
    )
  }

  <div
    class="mt-6 rounded-(--radius-card) border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
    role="status"
  >
    {
      locale === 'es'
        ? 'El envío en línea estará disponible próximamente. Mientras tanto, usa los canales de contacto directo.'
        : 'Online submission will be available soon. In the meantime, use the direct contact channels below.'
    }
  </div>

  <form class="mt-8 space-y-5" aria-disabled="true" novalidate>
    <div>
      <label for="name" class="block text-sm font-medium text-gray-800">
        {locale === 'es' ? 'Nombre' : 'Name'}
      </label>
      <input
        id="name"
        name="name"
        type="text"
        disabled
        class="mt-1.5 w-full rounded-lg border border-border bg-gray-50 px-4 py-2.5 text-gray-500"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-gray-800">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        disabled
        class="mt-1.5 w-full rounded-lg border border-border bg-gray-50 px-4 py-2.5 text-gray-500"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-gray-800">
        {locale === 'es' ? 'Teléfono' : 'Phone'}
      </label>
      <input
        id="phone"
        name="phone"
        type="tel"
        disabled
        class="mt-1.5 w-full rounded-lg border border-border bg-gray-50 px-4 py-2.5 text-gray-500"
      />
    </div>
    <div>
      <label for="experience" class="block text-sm font-medium text-gray-800">
        {locale === 'es' ? 'Experiencia de interés' : 'Experience of interest'}
      </label>
      <input
        id="experience"
        name="experience"
        type="text"
        disabled
        class="mt-1.5 w-full rounded-lg border border-border bg-gray-50 px-4 py-2.5 text-gray-500"
      />
    </div>
    <div>
      <label for="message" class="block text-sm font-medium text-gray-800">
        {locale === 'es' ? 'Mensaje' : 'Message'}
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        disabled
        class="mt-1.5 w-full rounded-lg border border-border bg-gray-50 px-4 py-2.5 text-gray-500"
      ></textarea>
    </div>
    <button
      type="button"
      disabled
      aria-disabled="true"
      class="cursor-not-allowed rounded-full bg-gray-400 px-6 py-3 font-semibold text-white"
    >
      {locale === 'es' ? 'Envío no disponible' : 'Submission unavailable'}
    </button>
  </form>

  <article class="mt-10 rounded-(--radius-card) border border-border bg-surface-elevated p-6 shadow-(--shadow-soft)">
    <h3 class="font-semibold text-primary">{locale === 'es' ? 'Contacto directo' : 'Direct contact'}</h3>
    <ul class="mt-4 space-y-2 text-sm text-muted">
      <li>
        <Button href={whatsappUrl} variant="ghost" size="sm" external class="!px-0">
          WhatsApp
        </Button>
      </li>
      <li>
        <a href={`mailto:${settings.contact.email}`} class="text-primary underline">
          {settings.contact.email}
        </a>
      </li>
      <li>
        <a href={`tel:${settings.contact.phone}`} class="text-primary underline">
          {settings.contact.phone}
        </a>
      </li>
    </ul>
  </article>
</section>
