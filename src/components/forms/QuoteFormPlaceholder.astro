---
import type { Locale } from '@/lib/i18n/config';
import type { PageContent, SiteSettings } from '@/lib/content';
import Button from '@/components/ui/Button.astro';

interface Props {
  locale: Locale;
  settings: SiteSettings;
  page: PageContent;
}

const { locale, settings, page } = Astro.props;
const whatsappUrl = `https://wa.me/${settings.contact.whatsapp}`;
const requestSection = page.sections?.find((s) => s.id === 'request') ?? page.sections?.[0];
const fieldClass =
  'mt-2 w-full border border-bark-slate/20 bg-surface px-3 py-3 text-deep-forest transition-colors focus:border-earth-gold focus:outline-none disabled:cursor-not-allowed disabled:opacity-60';

/** When set (e.g. on GitHub Pages), the form POSTs to this external API. */
const contactApiUrl = (import.meta.env.PUBLIC_CONTACT_API_URL || '').trim();
const canSubmit = Boolean(contactApiUrl);

const labels = {
  notice: locale === 'es'
    ? canSubmit
      ? 'Tu mensaje se enviará de forma segura. Te responderemos por correo o WhatsApp.'
      : 'El envío en línea estará disponible próximamente. Mientras tanto, usa los canales de contacto directo.'
    : canSubmit
      ? 'Your message will be sent securely. We will reply by email or WhatsApp.'
      : 'Online submission will be available soon. In the meantime, use the direct contact channels below.',
  submit: locale === 'es' ? (canSubmit ? 'Enviar mensaje' : 'Envío no disponible') : (canSubmit ? 'Send message' : 'Submission unavailable'),
  sending: locale === 'es' ? 'Enviando…' : 'Sending…',
  success: locale === 'es' ? 'Mensaje enviado. Gracias por escribirnos.' : 'Message sent. Thank you for writing.',
  error: locale === 'es' ? 'No se pudo enviar. Intenta de nuevo o usa WhatsApp.' : 'Could not send. Try again or use WhatsApp.',
};
---

<section id="solicitud" class="scroll-mt-24 border border-bark-slate/10 bg-sand-surface p-6 md:p-10">
  <h2 class="font-display text-headline-md text-deep-forest">
    {requestSection?.heading ?? (locale === 'es' ? 'Escríbanos' : 'Write to us')}
  </h2>
  {
    requestSection?.body && (
      <p class="mt-3 text-on-surface-variant">{requestSection.body}</p>
    )
  }

  <div
    class="mt-6 border border-bark-slate/20 bg-surface px-4 py-3 text-sm text-on-surface-variant"
    role="status"
    data-contact-status
  >
    {labels.notice}
  </div>

  <form
    class="mt-8 flex flex-col gap-[var(--spacing-stack-md)]"
    data-contact-form
    aria-disabled={canSubmit ? undefined : 'true'}
    novalidate
  >
    <div class="grid gap-[var(--spacing-stack-md)] md:grid-cols-2">
      <div>
        <label for="name" class="text-deep-forest">
          {locale === 'es' ? 'Nombre completo' : 'Full name'}
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required={canSubmit}
          disabled={!canSubmit}
          autocomplete="name"
          class={fieldClass}
        />
      </div>
      <div>
        <label for="email" class="text-deep-forest">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required={canSubmit}
          disabled={!canSubmit}
          autocomplete="email"
          class={fieldClass}
        />
      </div>
    </div>
    <div>
      <label for="phone" class="text-deep-forest">
        {locale === 'es' ? 'Teléfono' : 'Phone'}
      </label>
      <input
        id="phone"
        name="phone"
        type="tel"
        disabled={!canSubmit}
        autocomplete="tel"
        class={fieldClass}
      />
    </div>
    <div>
      <label for="experience" class="text-deep-forest">
        {locale === 'es' ? 'Experiencia de interés' : 'Experience of interest'}
      </label>
      <input id="experience" name="experience" type="text" disabled={!canSubmit} class={fieldClass} />
    </div>
    <div>
      <label for="message" class="text-deep-forest">
        {locale === 'es' ? 'Mensaje' : 'Message'}
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required={canSubmit}
        disabled={!canSubmit}
        class={`${fieldClass} resize-none`}
      ></textarea>
    </div>
    <div>
      <button
        type={canSubmit ? 'submit' : 'button'}
        disabled={!canSubmit}
        aria-disabled={canSubmit ? undefined : 'true'}
        data-contact-submit
        class:list={[
          'px-8 py-4 font-label-caps',
          canSubmit
            ? 'bg-deep-forest text-sand-surface transition-colors hover:bg-earth-gold hover:text-deep-forest'
            : 'cursor-not-allowed bg-bark-slate/40 text-sand-surface',
        ]}
      >
        {labels.submit}
      </button>
    </div>
  </form>

  <div class="mt-10 border-t border-bark-slate/10 pt-6">
    <p class="font-label-caps text-on-surface-variant">
      {locale === 'es' ? 'Contacto directo' : 'Direct contact'}
    </p>
    <ul class="mt-4 space-y-3 text-sm text-on-surface-variant">
      <li>
        <Button href={whatsappUrl} variant="ghost" size="sm" external class="!px-0">
          WhatsApp
        </Button>
      </li>
      <li>
        <a href={`mailto:${settings.contact.email}`} class="text-deep-forest underline-offset-4 hover:text-earth-gold hover:underline">
          {settings.contact.email}
        </a>
      </li>
      <li>
        <a href={`tel:${settings.contact.phone}`} class="text-deep-forest underline-offset-4 hover:text-earth-gold hover:underline">
          {settings.contact.phone}
        </a>
      </li>
    </ul>
  </div>
</section>

{
  canSubmit && (
    <script is:inline define:vars={{ contactApiUrl, labels }}>
      (() => {
        const form = document.querySelector('[data-contact-form]');
        const statusEl = document.querySelector('[data-contact-status]');
        const submitBtn = document.querySelector('[data-contact-submit]');
        if (!form || !statusEl || !submitBtn) return;

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const fd = new FormData(form);
          const payload = {
            name: String(fd.get('name') || '').trim(),
            email: String(fd.get('email') || '').trim(),
            phone: String(fd.get('phone') || '').trim(),
            experience: String(fd.get('experience') || '').trim(),
            message: String(fd.get('message') || '').trim(),
          };

          submitBtn.disabled = true;
          submitBtn.textContent = labels.sending;
          statusEl.textContent = labels.sending;

          try {
            const res = await fetch(contactApiUrl, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });
            if (!res.ok) throw new Error('bad status');
            statusEl.textContent = labels.success;
            form.reset();
          } catch {
            statusEl.textContent = labels.error;
          } finally {
            submitBtn.disabled = false;
            submitBtn.textContent = labels.submit;
          }
        });
      })();
    </script>
  )
}
