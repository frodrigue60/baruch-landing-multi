---
import type { Locale } from '@/lib/i18n/config';

interface Props {
  embedUrl: string;
  title: string;
  locale: Locale;
}

const { embedUrl, title, locale } = Astro.props;
const iframeTitle = locale === 'es' ? `Mapa de ubicación — ${title}` : `Location map — ${title}`;
---

<div class="overflow-hidden border border-bark-slate/10">
  <iframe
    src={embedUrl}
    title={iframeTitle}
    class="aspect-[16/10] w-full border-0 md:aspect-[21/9]"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  />
</div>
