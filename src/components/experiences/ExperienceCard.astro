---
import type { Locale } from '@/lib/i18n/config';
import type { Experience } from '@/lib/content';
import { getPagePath } from '@/lib/i18n/utils';
import { t } from '@/lib/i18n/labels';
import Button from '@/components/ui/Button.astro';

interface Props {
  experience: Experience;
  locale: Locale;
}

const { experience, locale } = Astro.props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-(--radius-card) border border-border bg-surface-elevated shadow-(--shadow-soft) transition-shadow hover:shadow-lg"
>
  <div class="aspect-[16/10] overflow-hidden bg-primary/5">
    <img
      src={experience.coverImage}
      alt={experience.title}
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold text-primary">{experience.title}</h3>
    <p class="mt-2 flex-1 text-muted">{experience.summary}</p>
    <div class="mt-5">
      <Button href={getPagePath('experiences', locale, experience.slug)} variant="ghost" size="sm" class="!px-0">
        {t('viewDetail', locale)} →
      </Button>
    </div>
  </div>
</article>
