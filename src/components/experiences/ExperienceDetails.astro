---
import type { Experience } from '@/lib/content';
import type { Locale } from '@/lib/i18n/config';
import { t } from '@/lib/i18n/labels';

interface Props {
  experience: Experience;
  locale: Locale;
}

const { experience, locale } = Astro.props;
---

{
  (experience.duration || experience.groupSize) && (
    <dl class="mt-8 flex flex-wrap gap-8 border border-bark-slate/10 bg-sand-surface px-6 py-5 text-sm">
      {
        experience.duration && (
          <div>
            <dt class="font-label-caps text-earth-gold">{t('duration', locale)}</dt>
            <dd class="mt-1 text-on-surface-variant">{experience.duration}</dd>
          </div>
        )
      }
      {
        experience.groupSize && (
          <div>
            <dt class="font-label-caps text-earth-gold">{t('groupSize', locale)}</dt>
            <dd class="mt-1 text-on-surface-variant">{experience.groupSize}</dd>
          </div>
        )
      }
    </dl>
  )
}

{
  experience.highlights && experience.highlights.length > 0 && (
    <div class="mt-10">
      <h2 class="font-display text-headline-md text-deep-forest">{t('highlights', locale)}</h2>
      <ul class="mt-4 space-y-2">
        {
          experience.highlights.map((item) => (
            <li class="flex items-start gap-3 text-on-surface-variant">
              <span class="mt-2 h-1 w-1 shrink-0 bg-earth-gold" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  )
}
