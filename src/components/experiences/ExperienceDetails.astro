---
import type { Experience } from '@/lib/content';
import type { Locale } from '@/lib/i18n/config';
import { t } from '@/lib/i18n/labels';

interface Props {
  experience: Experience;
  locale: Locale;
}

const { experience, locale } = Astro.props;
---

{
  (experience.duration || experience.groupSize) && (
    <dl class="mt-6 flex flex-wrap gap-6 rounded-lg border border-border bg-primary/5 px-5 py-4 text-sm">
      {
        experience.duration && (
          <div>
            <dt class="font-semibold text-primary">{t('duration', locale)}</dt>
            <dd class="mt-1 text-muted">{experience.duration}</dd>
          </div>
        )
      }
      {
        experience.groupSize && (
          <div>
            <dt class="font-semibold text-primary">{t('groupSize', locale)}</dt>
            <dd class="mt-1 text-muted">{experience.groupSize}</dd>
          </div>
        )
      }
    </dl>
  )
}

{
  experience.highlights && experience.highlights.length > 0 && (
    <div class="mt-8">
      <h2 class="text-lg font-bold text-primary">{t('highlights', locale)}</h2>
      <ul class="mt-3 space-y-2">
        {
          experience.highlights.map((item) => (
            <li class="flex items-start gap-2 text-muted">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  )
}
