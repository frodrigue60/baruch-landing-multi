---
import type { Locale } from '@/lib/i18n/config';
import type { Experience } from '@/lib/content';
import ExperienceCard from '@/components/experiences/ExperienceCard.astro';

interface Props {
  experiences: Experience[];
  locale: Locale;
  /** First item spans full width (experiences index layout). */
  highlightFirst?: boolean;
}

const { experiences, locale, highlightFirst = false } = Astro.props;
const [first, ...rest] = experiences;
---

{
  highlightFirst && first ? (
    <div class="grid grid-cols-1 gap-x-[var(--spacing-gutter)] gap-y-[var(--spacing-section)] md:grid-cols-12">
      <div class="md:col-span-12">
        <ExperienceCard experience={first} locale={locale} featured />
      </div>
      {rest.map((experience) => (
        <div class="md:col-span-6">
          <ExperienceCard experience={experience} locale={locale} />
        </div>
      ))}
    </div>
  ) : (
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {experiences.map((experience) => (
        <li>
          <ExperienceCard experience={experience} locale={locale} />
        </li>
      ))}
    </ul>
  )
}
