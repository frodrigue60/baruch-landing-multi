---
import type { Locale } from '@/lib/i18n/config';

interface Props {
  groups: Array<{
    id: string;
    label: string;
    items: Array<{ id: string; src: string; altText: string }>;
  }>;
  locale: Locale;
}

const { groups } = Astro.props;
---

<div class="space-y-12">
  {
    groups.map((group) => (
      <section aria-labelledby={`gallery-${group.id}`}>
        <h2 id={`gallery-${group.id}`} class="text-2xl font-bold text-primary">
          {group.label}
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            group.items.map((item) => (
              <li class="group overflow-hidden rounded-(--radius-card) border border-border bg-surface-elevated shadow-(--shadow-soft)">
                <img
                  src={item.src}
                  alt={item.altText}
                  class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </li>
            ))
          }
        </ul>
      </section>
    ))
  }
</div>
