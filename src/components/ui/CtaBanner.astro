---
import type { PageCta } from '@/lib/content';
import type { Locale } from '@/lib/i18n/config';
import Button from '@/components/ui/Button.astro';

interface Props {
  cta: PageCta;
  locale: Locale;
  primaryHref: string;
  secondaryHref: string;
}

const { cta, primaryHref, secondaryHref } = Astro.props;
---

<section class="bg-primary px-4 py-16 text-white md:py-20">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-3xl font-bold md:text-4xl">{cta.heading}</h2>
    <p class="mt-4 text-lg text-white/90">{cta.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href={primaryHref} variant="primary" size="lg">
        {cta.primaryLabel}
      </Button>
      <Button href={secondaryHref} variant="outline" size="lg">
        {cta.secondaryLabel}
      </Button>
    </div>
  </div>
</section>
