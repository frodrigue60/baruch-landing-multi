---
import type { PageCta } from '@/lib/content';
import type { Locale } from '@/lib/i18n/config';
import Button from '@/components/ui/Button.astro';

interface Props {
  cta: PageCta;
  locale: Locale;
  primaryHref: string;
  secondaryHref: string;
}

const { cta, primaryHref, secondaryHref } = Astro.props;
---

<section class="bg-deep-forest px-[var(--spacing-gutter)] py-[var(--spacing-section)] text-sand-surface">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="font-display text-headline-lg">{cta.heading}</h2>
    <p class="mt-4 text-body-lg text-sand-surface/80">{cta.body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href={primaryHref} variant="gold" size="lg">
        {cta.primaryLabel}
      </Button>
      <Button href={secondaryHref} variant="outline" size="lg" class="border-earth-gold text-earth-gold hover:bg-earth-gold hover:text-deep-forest">
        {cta.secondaryLabel}
      </Button>
    </div>
  </div>
</section>
