---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  as?: 'h1' | 'h2';
  class?: string;
}

const { title, subtitle, eyebrow, as = 'h2', class: className = '' } = Astro.props;
const Tag = as;
---

<div class:list={['max-w-2xl', className]}>
  {eyebrow && <span class="font-label-caps mb-3 block text-earth-gold">{eyebrow}</span>}
  <Tag class="font-display text-headline-lg text-deep-forest">{title}</Tag>
  {subtitle && <p class="mt-3 text-body-lg text-on-surface-variant">{subtitle}</p>}
</div>
