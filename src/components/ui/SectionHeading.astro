---
interface Props {
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2';
  class?: string;
}

const { title, subtitle, as = 'h2', class: className = '' } = Astro.props;
const Tag = as;
---

<div class:list={['max-w-2xl', className]}>
  <Tag class="text-3xl font-bold text-primary md:text-4xl">{title}</Tag>
  {subtitle && <p class="mt-3 text-lg text-muted">{subtitle}</p>}
</div>
