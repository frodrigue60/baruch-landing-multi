---
export type Variant = 'primary' | 'secondary' | 'outline' | 'ghost' | 'gold';
export type Size = 'sm' | 'md' | 'lg';

export interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  external?: boolean;
  class?: string;
  disabled?: boolean;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
  disabled = false,
  type = 'button',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-label-caps transition-colors duration-300 rounded-none focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-earth-gold';

const variants: Record<Variant, string> = {
  primary: 'bg-deep-forest text-sand-surface hover:bg-moss-green',
  gold: 'bg-earth-gold text-deep-forest hover:bg-secondary-fixed-dim',
  secondary: 'bg-deep-forest text-sand-surface hover:bg-moss-green',
  outline: 'border border-current bg-transparent hover:bg-sand-surface/10',
  ghost: 'text-deep-forest hover:text-earth-gold underline-offset-4 hover:underline',
};

const sizes: Record<Size, string> = {
  sm: 'px-4 py-2',
  md: 'px-8 py-4',
  lg: 'px-8 py-4',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} class={classes} {...externalAttrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} aria-disabled={disabled}>
      <slot />
    </button>
  )
}
