---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<section class="border-b border-border bg-surface-elevated px-4 py-12 md:py-16">
  <div class="mx-auto max-w-6xl">
    <h1 class="text-3xl font-bold text-primary md:text-4xl">{title}</h1>
    {description && <p class="mt-3 max-w-2xl text-lg text-muted">{description}</p>}
  </div>
</section>
