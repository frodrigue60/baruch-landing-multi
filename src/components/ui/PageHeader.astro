---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  centered?: boolean;
}

const { title, description, eyebrow, centered = false } = Astro.props;
---

<section
  class:list={[
    'px-[var(--spacing-margin-mobile)] pt-[var(--spacing-section)] pb-[var(--spacing-stack-lg)] md:px-[var(--spacing-gutter)]',
    centered && 'text-center',
  ]}
>
  <div class:list={['mx-auto max-w-[var(--container-max)]', centered && 'flex flex-col items-center']}>
    {
      eyebrow && (
        <span class="font-label-caps mb-4 block text-earth-gold">{eyebrow}</span>
      )
    }
    <h1 class="font-display text-display-hero text-deep-forest">{title}</h1>
    {
      description && (
        <p
          class:list={[
            'mt-[var(--spacing-stack-md)] max-w-2xl text-body-lg text-on-surface-variant',
            centered && 'mx-auto',
          ]}
        >
          {description}
        </p>
      )
    }
  </div>
</section>
