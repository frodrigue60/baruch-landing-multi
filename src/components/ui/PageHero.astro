---
import type { Locale } from '@/lib/i18n/config';

export interface Props {
  heading: string;
  subtitle?: string;
  locale: Locale;
  class?: string;
  brand?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  heading,
  subtitle,
  class: className = '',
  brand,
  imageSrc = '/images/placeholder-gallery-1.svg',
  imageAlt = '',
} = Astro.props;
---

<section class:list={['relative flex min-h-[70vh] w-full items-center justify-center overflow-hidden bg-deep-forest md:min-h-[795px]', className]}>
  <div class="absolute inset-0">
    <img src={imageSrc} alt={imageAlt} class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-deep-forest/55" aria-hidden="true"></div>
  </div>
  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center px-[var(--spacing-gutter)] py-20 text-center">
    {
      brand && (
        <p class="font-display mb-4 text-headline-md uppercase tracking-widest text-sand-surface/90">
          {brand}
        </p>
      )
    }
    <h1 class="font-display text-display-hero text-sand-surface">{heading}</h1>
    {
      subtitle && (
        <p class="mt-[var(--spacing-stack-md)] max-w-2xl text-body-lg text-sand-surface/90">
          {subtitle}
        </p>
      )
    }
    <div class="mt-[var(--spacing-stack-lg)] flex w-full flex-col items-stretch justify-center gap-4 sm:w-auto sm:flex-row">
      <slot name="actions" />
    </div>
  </div>
</section>
