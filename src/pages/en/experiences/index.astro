---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import ExperienceGrid from '@/components/experiences/ExperienceGrid.astro';
import { getExperiences } from '@/lib/content';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';

const locale = 'en';
const experiences = getExperiences(locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
const title = 'Experiences — Baruch';
const description = 'Explore our ecotourism and wellness experiences.';
---

<BaseLayout {title} {description} locale={locale} {alternateLocaleUrl}>
  <PageHeader title="Experiences" description={description} />
  <Section>
    <ExperienceGrid experiences={experiences} locale={locale} />
  </Section>
</BaseLayout>
