---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import ExperienceDetails from '@/components/experiences/ExperienceDetails.astro';
import ExperienceGallery from '@/components/experiences/ExperienceGallery.astro';
import { getExperience, getExperienceSlugs } from '@/lib/content';
import { getAlternateLocaleUrl, getPagePath } from '@/lib/i18n/utils';
import { t } from '@/lib/i18n/labels';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return getExperienceSlugs('en').map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const locale = 'en';
const { slug } = Astro.params;
const experience = slug ? getExperience(slug, locale) : undefined;

if (!experience) {
  return Astro.redirect(getPagePath('experiences', locale));
}

const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
---

<BaseLayout
  title={`${experience.title} — Baruch`}
  description={experience.summary}
  locale={locale}
  alternateLocaleUrl={alternateLocaleUrl}
  image={experience.coverImage}
  ogType="article"
>
  <section class="relative h-[50vh] min-h-[360px] w-full overflow-hidden bg-deep-forest md:h-[60vh]">
    <img
      src={experience.coverImage}
      alt={experience.title}
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-deep-forest/40" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 container-editorial pb-10">
      <h1 class="font-display text-display-hero text-sand-surface">{experience.title}</h1>
    </div>
  </section>

  <section class="container-editorial max-w-3xl py-[var(--spacing-section)]">
    <p class="text-body-lg text-on-surface-variant">{experience.summary}</p>
    <p class="mt-6 leading-relaxed text-on-surface-variant">{experience.description}</p>
    <ExperienceDetails experience={experience} locale={locale} />
    <ExperienceGallery
      images={experience.gallery ?? []}
      title={experience.title}
      locale={locale}
    />
    <div class="mt-10 flex flex-wrap gap-4 border-t border-bark-slate/10 pt-8">
      <Button href={getPagePath('quote', locale)} variant="primary">
        {t('quote', locale)}
      </Button>
      <Button href={getPagePath('experiences', locale)} variant="ghost">
        {t('backToExperiences', locale)}
      </Button>
    </div>
  </section>
</BaseLayout>
