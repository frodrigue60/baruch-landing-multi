---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { getExperience, getExperienceSlugs } from '@/lib/content';
import { getAlternateLocaleUrl, getPagePath } from '@/lib/i18n/utils';
import { t } from '@/lib/i18n/labels';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return getExperienceSlugs('en').map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const locale = 'en';
const { slug } = Astro.params;
const experience = slug ? getExperience(slug, locale) : undefined;

if (!experience) {
  return Astro.redirect(getPagePath('experiences', locale));
}

const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
---

<BaseLayout
  title={`${experience.title} — Baruch`}
  description={experience.summary}
  locale={locale}
  alternateLocaleUrl={alternateLocaleUrl}
>
  <PageHeader title={experience.title} description={experience.summary} />
  <Section narrow>
    <div class="overflow-hidden rounded-(--radius-card) border border-border bg-surface-elevated shadow-(--shadow-soft)">
      <img
        src={experience.coverImage}
        alt={experience.title}
        class="aspect-[21/9] w-full object-cover"
      />
      <div class="p-8 md:p-10">
        <p class="text-lg leading-relaxed text-muted">{experience.description}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={getPagePath('quote', locale)} variant="primary">
            {t('quote', locale)}
          </Button>
          <Button href={getPagePath('experiences', locale)} variant="ghost">
            {t('backToExperiences', locale)}
          </Button>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
