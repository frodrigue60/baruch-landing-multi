---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import GalleryByCategory from '@/components/gallery/GalleryByCategory.astro';
import { getGalleryGroupedByCategory } from '@/lib/content';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';

const locale = 'en';
const groups = getGalleryGroupedByCategory(locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
const title = 'Gallery — Baruch';
const description = 'Photos of nature, experiences and facilities at Baruch.';
---

<BaseLayout {title} {description} locale={locale} {alternateLocaleUrl}>
  <PageHeader title="Gallery" description={description} />
  <section class="container-editorial pb-[var(--spacing-section)]">
    <GalleryByCategory groups={groups} locale={locale} />
  </section>
</BaseLayout>
