---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';

const locale = 'en';
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
const title = 'Privacy notice — Baruch';
const description = 'Privacy policy and personal data handling.';
---

<BaseLayout {title} {description} locale={locale} {alternateLocaleUrl}>
  <PageHeader title="Privacy notice" />
  <Section narrow>
    <article class="prose prose-neutral max-w-none rounded-(--radius-card) border border-border bg-surface-elevated p-8 text-muted shadow-(--shadow-soft)">
      <p>
        In the current MVP, this site does not collect personal data through online forms.
        This notice will be updated when the quote form is activated.
      </p>
    </article>
  </Section>
</BaseLayout>
