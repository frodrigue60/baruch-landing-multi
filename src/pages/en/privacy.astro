---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { getPage } from '@/lib/content';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';

const locale = 'en';
const page = getPage('privacy', locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  alternateLocaleUrl={alternateLocaleUrl}
>
  <PageHeader title={page.heading} />
  <section class="container-editorial max-w-3xl pb-[var(--spacing-section)]">
    <div class="space-y-10">
      {
        page.sections?.map((section) => (
          <article class="border-b border-bark-slate/10 pb-10 last:border-0">
            <h2 class="font-display text-headline-md text-deep-forest">{section.heading}</h2>
            <p class="mt-4 leading-relaxed text-on-surface-variant">{section.body}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
