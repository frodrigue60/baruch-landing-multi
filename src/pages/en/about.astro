---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import { getPage } from '@/lib/content';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';

const locale = 'en';
const page = getPage('about', locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  alternateLocaleUrl={alternateLocaleUrl}
>
  <PageHeader title={page.heading} description={page.description} />
  <Section narrow>
    <div class="grid gap-6 md:grid-cols-2">
      {
        page.sections?.map((section) => (
          <article class="rounded-(--radius-card) border border-border bg-surface-elevated p-8 shadow-(--shadow-soft)">
            <h2 class="text-xl font-bold text-primary">{section.heading}</h2>
            <p class="mt-4 text-muted leading-relaxed">{section.body}</p>
          </article>
        ))
      }
    </div>
  </Section>
</BaseLayout>
