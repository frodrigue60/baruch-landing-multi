---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getExperiences } from '@/lib/content';
import { getAlternateLocaleUrl, getPagePath } from '@/lib/i18n/utils';

const locale = 'es';
const experiences = getExperiences(locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
const title = 'Experiencias — Baruch';
const description = 'Explora nuestras experiencias de ecoturismo y wellness.';
---

<BaseLayout {title} {description} locale={locale} {alternateLocaleUrl}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-3xl font-bold text-primary">Experiencias</h1>
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {
        experiences.map((experience) => (
          <li class="rounded-lg border border-gray-200 bg-white p-6">
            <h2 class="text-xl font-semibold">{experience.title}</h2>
            <p class="mt-2 text-gray-600">{experience.summary}</p>
            <a
              href={getPagePath('experiences', locale, experience.slug)}
              class="mt-4 inline-block font-semibold text-primary underline"
            >
              Ver detalle
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
