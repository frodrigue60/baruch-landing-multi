---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';

const locale = 'es';
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
const title = 'Aviso de privacidad — Baruch';
const description = 'Política de privacidad y manejo de datos personales.';
---

<BaseLayout {title} {description} locale={locale} {alternateLocaleUrl}>
  <PageHeader title="Aviso de privacidad" />
  <Section narrow>
    <article class="prose prose-neutral max-w-none rounded-(--radius-card) border border-border bg-surface-elevated p-8 text-muted shadow-(--shadow-soft)">
      <p>
        En el MVP actual, el sitio no recopila datos personales mediante formularios en línea.
        Este aviso se actualizará cuando se active el formulario de cotización.
      </p>
    </article>
  </Section>
</BaseLayout>
