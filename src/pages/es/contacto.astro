---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { getSiteSettings } from '@/lib/content';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';
import { t } from '@/lib/i18n/labels';

const locale = 'es';
const settings = getSiteSettings(locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
const title = 'Contacto — Baruch';
const description = 'Datos de contacto, ubicación y redes sociales.';
const whatsappUrl = `https://wa.me/${settings.contact.whatsapp}`;
---

<BaseLayout {title} {description} locale={locale} {alternateLocaleUrl}>
  <PageHeader title="Contacto" description={description} />
  <Section narrow>
    <div class="grid gap-6 md:grid-cols-2">
      <article class="rounded-(--radius-card) border border-border bg-surface-elevated p-8 shadow-(--shadow-soft)">
        <h2 class="text-lg font-semibold text-primary">Información</h2>
        <ul class="mt-4 space-y-3 text-muted">
          <li>
            <span class="font-medium text-gray-900">Teléfono:</span>{' '}
            <a href={`tel:${settings.contact.phone}`} class="text-primary underline">
              {settings.contact.phone}
            </a>
          </li>
          <li>
            <span class="font-medium text-gray-900">Email:</span>{' '}
            <a href={`mailto:${settings.contact.email}`} class="text-primary underline">
              {settings.contact.email}
            </a>
          </li>
          <li>
            <span class="font-medium text-gray-900">Ubicación:</span> {settings.contact.address}
          </li>
        </ul>
      </article>
      <article class="flex flex-col justify-center rounded-(--radius-card) border border-border bg-primary/5 p-8">
        <p class="text-muted">¿Prefieres escribirnos directamente?</p>
        <Button href={whatsappUrl} variant="secondary" external class="mt-4 self-start">
          {t('whatsapp', locale)}
        </Button>
      </article>
    </div>
  </Section>
</BaseLayout>
