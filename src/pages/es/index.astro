---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CtaBanner from '@/components/ui/CtaBanner.astro';
import Button from '@/components/ui/Button.astro';
import ExperienceGrid from '@/components/experiences/ExperienceGrid.astro';
import { getFeaturedExperiences, getPage, getSiteSettings } from '@/lib/content';
import { getAlternateLocaleUrl, getPagePath } from '@/lib/i18n/utils';
import { t } from '@/lib/i18n/labels';

const locale = 'es';
const page = getPage('home', locale);
const settings = getSiteSettings(locale);
const experiences = getFeaturedExperiences(locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  alternateLocaleUrl={alternateLocaleUrl}
>
  <PageHero heading={page.heading} subtitle={settings.tagline} locale={locale}>
    <div slot="actions" class="flex flex-wrap items-center justify-center gap-4">
      <Button href={getPagePath('quote', locale)} variant="primary" size="lg">
        {t('quote', locale)}
      </Button>
      <Button href={`https://wa.me/${settings.contact.whatsapp}`} variant="outline" size="lg" external>
        {t('whatsappShort', locale)}
      </Button>
    </div>
  </PageHero>

  <Section>
    <div class="grid gap-10 md:grid-cols-3">
      {
        page.sections?.map((section) => (
          <article class="rounded-(--radius-card) border border-border bg-surface-elevated p-6 shadow-(--shadow-soft)">
            <h2 class="text-xl font-bold text-primary">{section.heading}</h2>
            <p class="mt-3 text-muted leading-relaxed">{section.body}</p>
          </article>
        ))
      }
    </div>

    <SectionHeading title={t('featuredExperiences', locale)} class="mb-8 mt-16" />
    <ExperienceGrid experiences={experiences} locale={locale} />
  </Section>

  {
    page.cta && (
      <CtaBanner
        cta={page.cta}
        locale={locale}
        primaryHref={getPagePath('quote', locale)}
        secondaryHref={getPagePath('experiences', locale)}
      />
    )
  }
</BaseLayout>
