---
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuoteFormPlaceholder from '@/components/forms/QuoteFormPlaceholder.astro';
import { getSiteSettings } from '@/lib/content';
import { getAlternateLocaleUrl } from '@/lib/i18n/utils';

const locale = 'es';
const settings = getSiteSettings(locale);
const alternateLocaleUrl = getAlternateLocaleUrl(Astro.url.pathname);
const title = 'Cotizar — Baruch';
const description = 'Solicita información o cotización para tu experiencia.';
---

<BaseLayout {title} {description} locale={locale} {alternateLocaleUrl}>
  <QuoteFormPlaceholder locale={locale} settings={settings} />
</BaseLayout>
