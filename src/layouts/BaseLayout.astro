---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFloat from '@/components/layout/WhatsAppFloat.astro';
import type { Locale } from '@/lib/i18n/config';
import { getSiteSettings } from '@/lib/content';
import { t } from '@/lib/i18n/labels';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternateLocaleUrl: string;
}

const { title, description, locale, alternateLocaleUrl } = Astro.props;
const settings = getSiteSettings(locale);
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      hreflang={locale === 'es' ? 'en' : 'es'}
      href={new URL(alternateLocaleUrl, Astro.url.origin).href}
    />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
  </head>
  <body class="flex min-h-screen flex-col pb-20 md:pb-0">
    <a
      href="#main-content"
      class="sr-only-focusable fixed left-4 top-4 z-[100] rounded bg-accent px-4 py-2 font-semibold text-primary-dark"
    >
      {t('skipToContent', locale)}
    </a>
    <Header locale={locale} siteName={settings.siteName} whatsapp={settings.contact.whatsapp} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} settings={settings} />
    <WhatsAppFloat locale={locale} whatsapp={settings.contact.whatsapp} />
  </body>
</html>
