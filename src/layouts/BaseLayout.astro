---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Locale } from '@/lib/i18n/config';
import { getSiteSettings } from '@/lib/content';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternateLocaleUrl: string;
}

const { title, description, locale, alternateLocaleUrl } = Astro.props;
const settings = getSiteSettings(locale);
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={new URL(alternateLocaleUrl, Astro.url.origin).href} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header locale={locale} siteName={settings.siteName} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} settings={settings} />
  </body>
</html>
