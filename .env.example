# Public site origin for canonical + Open Graph absolute URLs (SSG)
PUBLIC_SITE_URL=https://baruch-landing-demo.luisrodz.dev

# Host port published for the landing (docker compose: ${APP_PORT}:80)
APP_PORT=3003

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels)
#
# Shared tunnel with another stack: prefer host.docker.internal:${APP_PORT}
# Solo landing-baruch compose: http://web:80 also works when attached to companion network
CLOUDFLARE_TUNNEL_TOKEN=
