# =============================================================================
# Public (safe to expose in the browser / SSG). Must be prefixed with PUBLIC_.
# =============================================================================

# Absolute origin for canonical + Open Graph URLs.
# Custom subdomain (Cloudflare → GitHub Pages): use the subdomain, base = /
PUBLIC_SITE_URL=https://baruch-landing-multi-demo.luisrodz.dev

# Path prefix. For a custom subdomain the site is at the domain root → /
PUBLIC_BASE_PATH=/

# If you publish only on https://<user>.github.io/<repo>/ (no custom domain),
# leave PUBLIC_SITE_URL unset in Actions (inferred) or set:
# PUBLIC_SITE_URL=https://<user>.github.io
# PUBLIC_BASE_PATH=/<repo>/

# Contact form POST target when the static site is on GitHub Pages (no server APIs there).
# Point this at a separately hosted API (see api/contact.ts). Leave empty to keep the placeholder UI.
# PUBLIC_CONTACT_API_URL=https://api.example.com/contact

# =============================================================================
# Server secrets (never commit real values; never use PUBLIC_ prefix)
# =============================================================================

# Host port published for the landing (docker compose: ${APP_PORT}:80)
APP_PORT=3003

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels). Local/docker only.
CLOUDFLARE_TUNNEL_TOKEN=

# Contact API (api/contact.ts) — Resend
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=hola@example.com
# CONTACT_FROM_EMAIL=Baruch <onboarding@resend.dev>

# Allowed browser origin(s) for the contact API (CORS). Comma-separated.
# CONTACT_CORS_ORIGIN=https://baruch-landing-multi-demo.luisrodz.dev
